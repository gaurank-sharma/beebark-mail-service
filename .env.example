# SMTP credentials (same values that already work from Vercel)
EMAIL_HOST=smtpout.secureserver.net
EMAIL_PORT=465
EMAIL_USER=info@thebeebark.com
EMAIL_PASSWORD=your-mailbox-password
EMAIL_FROM=info@thebeebark.com

# Shared secret — must match MAIL_SHARED_SECRET on the backend (Render).
# Generate a long random value, e.g.  openssl rand -hex 32
MAIL_SHARED_SECRET=change-me-to-a-long-random-secret
